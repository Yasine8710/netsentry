# Backend
NETSENTRY_DATABASE_URL=sqlite:///./var/netsentry.db
NETSENTRY_UPLOAD_DIR=./var/uploads
NETSENTRY_MAX_UPLOAD_MB=50
NETSENTRY_MAX_PACKETS=500000
NETSENTRY_ANALYSIS_TIMEOUT_S=120
# Analysis records older than this are purged. Uploaded files are deleted right after analysis.
NETSENTRY_RETENTION_HOURS=720
NETSENTRY_CORS_ORIGINS=http://localhost:5173
